{
  "name": "quickinvoice-backend",
  "version": "1.0.0",
  "description": "QuickInvoice Express API for invoice management.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/index.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:watch": "node --watch --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:coverage": "c8 node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "keywords": [
    "invoice",
    "express",
    "mongodb",
    "pwa"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.15.2",
    "puppeteer": "^25.1.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
