NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/quickinvoice
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Refresh tokens. REFRESH_TOKEN_SECRET falls back to JWT_SECRET when unset; set a
# dedicated secret in production so rotating one does not invalidate the other.
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d
# Password reset link lifetime in minutes (default 30).
PASSWORD_RESET_TTL_MINUTES=30
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
# Play Store / download link shown in invite emails. Leave blank to omit it.
APP_DOWNLOAD_URL=
# Email provider: Resend (https://resend.com). Set RESEND_API_KEY to enable
# sending; RESEND_FROM must be a verified sender/domain in your Resend account.
RESEND_API_KEY=
RESEND_FROM="QuickInvoice <invoices@yourdomain.com>"

# DEV ONLY — SMTP override. When SMTP_HOST is set, all mail routes through SMTP
# instead of Resend. Use this while no domain is verified in Resend: the shared
# `onboarding@resend.dev` sender only delivers to the Resend account owner, so
# invites to a tester's address are silently dropped. Leave SMTP_HOST blank in
# production to keep using Resend.
#
# Gmail: enable 2-Step Verification, then create an App Password
# (https://myaccount.google.com/apppasswords) and use it as SMTP_PASS.
# SMTP_FROM must be the same Gmail address or Gmail rewrites/rejects it.
# Cap is ~500 recipients/day.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="BillJi Dev <you@gmail.com>"

# Two-factor authentication (TOTP authenticator app + email OTP).
# TWO_FACTOR_ENC_KEY encrypts TOTP secrets at rest — 32 bytes as 64 hex chars or
# base64. Generate: `openssl rand -hex 32`. If unset it is derived from JWT_SECRET
# (fine for dev). Set a dedicated key in production so rotating JWT_SECRET does not
# lock users out of their authenticator.
TWO_FACTOR_ENC_KEY=
TWO_FACTOR_ISSUER=BillJi
TWO_FACTOR_CHALLENGE_TTL_MINUTES=5
TWO_FACTOR_TRUSTED_DEVICE_DAYS=30

# Cloudflare R2 (S3-compatible) — caches rendered invoice PDFs and stores data-export
# archives. Leave blank to disable caching (PDFs render on demand); note that data
# export is UNAVAILABLE without R2 and POST /exports returns 503.
# All four below required to enable.
#
# Set an R2 lifecycle rule deleting objects under the `exports/` prefix after 7 days.
# The API enforces the same 7-day expiry on every download, but the rule is what
# actually reclaims the storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: override endpoint (defaults to https://<account-id>.r2.cloudflarestorage.com)
R2_ENDPOINT=
# Optional: public custom domain / r2.dev base URL to serve cached PDFs directly
R2_PUBLIC_BASE_URL=
# Optional: presigned URL lifetime in seconds (default 900) when no public base URL
R2_SIGNED_URL_TTL_SECONDS=900

# Google Sign-In: comma-separated OAuth client IDs accepted as the ID token "aud".
# Get the web client ID (client_type 3) from mobile/google-services.json.
GOOGLE_OAUTH_CLIENT_IDS=

# Firebase Admin (push notifications). Either the whole service-account JSON in
# FIREBASE_SERVICE_ACCOUNT as one line of raw JSON (not base64), or the three
# fields below, where FIREBASE_PRIVATE_KEY may keep its literal \n escapes.
# Leave blank to disable push delivery; the rest of the API is unaffected.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay. Optional as a group, but half-configured is refused at boot in
# production: set all three or none.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional API base override (default https://api.razorpay.com/v1)
RAZORPAY_API_BASE_URL=

# Subscription enforcement kill-switch: off (default) | warn | on.
BILLING_ENFORCEMENT=off

# Offline sync safety lag in milliseconds. Leave unset to use the default.
SYNC_SAFETY_LAG_MS=

# --- Render notes -----------------------------------------------------------
# PORT is injected by Render; do not set it there.
# PUPPETEER_CACHE_DIR must be set on Render to a path inside the project
# directory (/opt/render/project/src/.cache/puppeteer) so the Chromium that
# `npm ci` downloads survives into the runtime container. See render.yaml.
